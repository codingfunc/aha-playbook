#!/usr/bin/env bash
# SessionStart hook: injects kernel.md as always-on context.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
kernel=$(cat "${SCRIPT_DIR}/kernel.md")

# The harness passes this session's transcript path on stdin. Naming it lets
# the handoff skill copy the right file when several sessions are open.
transcript=""
if [ ! -t 0 ] && command -v jq >/dev/null 2>&1; then
    transcript=$(jq -r '.transcript_path // empty' 2>/dev/null || true)
fi
if [ -n "$transcript" ]; then
    kernel+=$'\n\n## Session transcript\n\n'
    kernel+="This session's raw transcript is \`${transcript}\`. The handoff skill copies it. It is a log: never read it whole."
fi

# JSON-escape via bash parameter substitution; each pass is a single C-level op.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$kernel")

# Emit ONLY hookSpecificOutput: Claude Code reads additional_context too, and
# does not deduplicate. printf rather than heredoc: heredocs hang on bash 5.3+.
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"

exit 0
